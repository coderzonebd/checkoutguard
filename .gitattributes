# Text files are stored with LF in the repository, whatever the line endings
# of the machine that commits them.
* text=auto eol=lf

# Binary files: never convert line endings and never show a text diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.icc   binary
*.pdf   binary
*.zip   binary
*.mo    binary

# Left out of `git archive` exports only. The release zip and the WordPress.org
# deploy use .distignore; keep both lists in sync.
/tests export-ignore
/.gitattributes export-ignore
